<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="loan-collection-process" name="Loan Collection Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="New Overdue Case">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Activity_CheckCompliance" />

    <bpmn:businessRuleTask id="Activity_CheckCompliance" name="Check Compliance">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="complianceCheck" resultVariable="complianceResult" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_CheckCompliance" targetRef="Activity_CalculatePriority" />

    <bpmn:businessRuleTask id="Activity_CalculatePriority" name="Calculate Priority">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="priorityScoring" resultVariable="priorityResult" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:sequenceFlow id="Flow_3" sourceRef="Activity_CalculatePriority" targetRef="Activity_DetermineStrategy" />

    <bpmn:serviceTask id="Activity_DetermineStrategy" name="Determine Contact Strategy">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="determine-strategy" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_4" sourceRef="Activity_DetermineStrategy" targetRef="Activity_SendNotification" />

    <bpmn:serviceTask id="Activity_SendNotification" name="Send Notification">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-notification" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_5" sourceRef="Activity_SendNotification" targetRef="EndEvent_1" />

    <bpmn:endEvent id="EndEvent_1" name="Case Processed">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="loan-collection-process">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="180" y="100" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="157" y="143" width="82" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_CheckCompliance_di" bpmnElement="Activity_CheckCompliance">
        <dc:Bounds x="280" y="78" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_CalculatePriority_di" bpmnElement="Activity_CalculatePriority">
        <dc:Bounds x="440" y="78" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_DetermineStrategy_di" bpmnElement="Activity_DetermineStrategy">
        <dc:Bounds x="600" y="78" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_SendNotification_di" bpmnElement="Activity_SendNotification">
        <dc:Bounds x="760" y="78" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="920" y="100" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="898" y="143" width="81" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="216" y="118" />
        <di:waypoint x="280" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="380" y="118" />
        <di:waypoint x="440" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="540" y="118" />
        <di:waypoint x="600" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="700" y="118" />
        <di:waypoint x="760" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="860" y="118" />
        <di:waypoint x="920" y="118" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
