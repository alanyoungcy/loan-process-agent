<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_dispute" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="dispute-resolution-process" name="Dispute Resolution Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent" name="Dispute Filed">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent" targetRef="Task_LogDispute" />
    <bpmn:serviceTask id="Task_LogDispute" name="Log Dispute">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="log-dispute" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_LogDispute" targetRef="Task_PauseCollection" />
    <bpmn:serviceTask id="Task_PauseCollection" name="Pause Collection Activities">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="pause-collection" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_PauseCollection" targetRef="Task_Investigation" />
    <bpmn:userTask id="Task_Investigation" name="Investigate Dispute">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Investigation" targetRef="Task_MakeDecision" />
    <bpmn:userTask id="Task_MakeDecision" name="Make Decision">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_MakeDecision" targetRef="Gateway_Decision" />
    <bpmn:exclusiveGateway id="Gateway_Decision" name="Dispute Valid?">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_Valid</bpmn:outgoing>
      <bpmn:outgoing>Flow_Invalid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Valid" name="Valid" sourceRef="Gateway_Decision" targetRef="Task_AdjustDebt">
      <bpmn:conditionExpression>= disputeValid = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Invalid" name="Invalid" sourceRef="Gateway_Decision" targetRef="Task_ResumeCollection">
      <bpmn:conditionExpression>= disputeValid = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Task_AdjustDebt" name="Adjust Debt Amount">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="adjust-debt" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Valid</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ResumeCollection" name="Resume Collection">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="resume-collection" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Invalid</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_AdjustDebt" targetRef="Task_NotifyCustomer" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_ResumeCollection" targetRef="Task_NotifyCustomer" />
    <bpmn:serviceTask id="Task_NotifyCustomer" name="Notify Customer">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-customer" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_NotifyCustomer" targetRef="EndEvent" />
    <bpmn:endEvent id="EndEvent" name="Dispute Resolved">
      <bpmn:incoming>Flow_8</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="dispute-resolution-process">
      <bpmndi:BPMNShape id="StartEvent_di" bpmnElement="StartEvent">
        <dc:Bounds x="180" y="180" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_LogDispute_di" bpmnElement="Task_LogDispute">
        <dc:Bounds x="280" y="158" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PauseCollection_di" bpmnElement="Task_PauseCollection">
        <dc:Bounds x="440" y="158" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Investigation_di" bpmnElement="Task_Investigation">
        <dc:Bounds x="600" y="158" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_MakeDecision_di" bpmnElement="Task_MakeDecision">
        <dc:Bounds x="760" y="158" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Decision_di" bpmnElement="Gateway_Decision" isMarkerVisible="true">
        <dc:Bounds x="915" y="173" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AdjustDebt_di" bpmnElement="Task_AdjustDebt">
        <dc:Bounds x="1030" y="78" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ResumeCollection_di" bpmnElement="Task_ResumeCollection">
        <dc:Bounds x="1030" y="238" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyCustomer_di" bpmnElement="Task_NotifyCustomer">
        <dc:Bounds x="1190" y="158" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_di" bpmnElement="EndEvent">
        <dc:Bounds x="1352" y="180" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="216" y="198" />
        <di:waypoint x="280" y="198" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="380" y="198" />
        <di:waypoint x="440" y="198" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="540" y="198" />
        <di:waypoint x="600" y="198" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="700" y="198" />
        <di:waypoint x="760" y="198" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="860" y="198" />
        <di:waypoint x="915" y="198" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Valid_di" bpmnElement="Flow_Valid">
        <di:waypoint x="940" y="173" />
        <di:waypoint x="940" y="118" />
        <di:waypoint x="1030" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Invalid_di" bpmnElement="Flow_Invalid">
        <di:waypoint x="940" y="223" />
        <di:waypoint x="940" y="278" />
        <di:waypoint x="1030" y="278" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="1130" y="118" />
        <di:waypoint x="1240" y="118" />
        <di:waypoint x="1240" y="158" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="1130" y="278" />
        <di:waypoint x="1240" y="278" />
        <di:waypoint x="1240" y="238" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="1290" y="198" />
        <di:waypoint x="1352" y="198" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
