# Copy to .env for local development. Never commit the populated .env file.

APP_NAME=Loan Agent Backend
APP_VERSION=0.1.0
DEBUG=false

POSTGRES_DB=loan_agent
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://admin:change-me@localhost:5432/loan_agent
REDIS_URL=redis://localhost:6379/0
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=change-me
RABBITMQ_URL=amqp://admin:change-me@localhost:5672/

SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

CAMUNDA_DMN_URL=http://localhost:8081
ZEEBE_GATEWAY_ADDRESS=localhost:26500
CAMUNDA_OPERATE_URL=http://localhost:8080
CAMUNDA_TASKLIST_URL=http://localhost:8082
CHROMADB_URL=http://localhost:8100
CHROMADB_HOST=localhost
CHROMADB_PORT=8100
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
DEFAULT_LLM_PROVIDER=openai
