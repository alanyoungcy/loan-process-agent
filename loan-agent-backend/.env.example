# Application
APP_NAME=Loan Agent Backend
APP_VERSION=0.1.0
DEBUG=True

# Database
DATABASE_URL=postgresql+asyncpg://admin:change-me@postgres:5432/loan_agent

# Redis
REDIS_URL=redis://redis:6379/0

# RabbitMQ
RABBITMQ_URL=amqp://admin:change-me@rabbitmq:5672/

# External Services
DROOLS_URL=http://drools:8081
CAMUNDA_URL=http://camunda:8080/engine-rest
CHROMADB_URL=http://chromadb:8000

# JWT
SECRET_KEY=change-this-to-a-secure-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# GenAI - OpenAI Configuration
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# GenAI - Anthropic Configuration
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# GenAI - Default Provider (openai or anthropic)
DEFAULT_LLM_PROVIDER=openai

# Task Queue
TASK_TIMEOUT=300
MAX_RETRIES=3
